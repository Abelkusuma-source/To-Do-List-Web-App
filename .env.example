# Turso Database Credentials
# Get these by running:
#   1. turso auth login
#   2. turso db create todo-app
#   3. turso db show --url todo-app
#   4. turso db tokens create todo-app

TURSO_CONNECTION_URL=libsql://your-database-username.turso.io
TURSO_AUTH_TOKEN=your-auth-token

# Google OAuth Credentials
# Get these from Google Cloud Console:
#   1. Create a project at https://console.cloud.google.com
#   2. Go to APIs & Services > Credentials
#   3. Create OAuth client ID (Web application)
#   4. Add redirect URI: http://localhost:4321/api/auth/callback/google
#   5. For production, add: https://your-domain.com/api/auth/callback/google

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# BetterAuth Configuration
BETTER_AUTH_SECRET=generate-a-random-secret-at-least-32-chars
BETTER_AUTH_URL=http://localhost:4321
