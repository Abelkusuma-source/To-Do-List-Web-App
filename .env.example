# Turso Database Credentials
# Get these by running:
#   1. turso auth login
#   2. turso db create todo-app
#   3. turso db show --url todo-app
#   4. turso db tokens create todo-app

TURSO_CONNECTION_URL=libsql://your-database-username.turso.io
TURSO_AUTH_TOKEN=your-auth-token

# Google OAuth Credentials
# Get these from Google Cloud Console:
#   1. Create a project at https://console.cloud.google.com
#   2. Go to APIs & Services > Credentials
#   3. Create OAuth client ID (Web application)
#   4. Add redirect URI: http://localhost:4321/api/auth/callback/google
#   5. For production, add: https://<your-domain>.pages.dev/api/auth/callback/google

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# BetterAuth Configuration
BETTER_AUTH_SECRET=generate-a-random-secret-at-least-32-chars
BETTER_AUTH_URL=http://localhost:4321

# Storage Mode ("local" for development, "r2" for production)
STORAGE_MODE=local

# Local Storage Config (for STORAGE_MODE=local)
LOCAL_STORAGE_PATH=./data/uploads
LOCAL_STORAGE_BASE_URL=/uploads

# R2 Storage Config (for STORAGE_MODE=r2)
# Get these from your Cloudflare R2 dashboard:
#   1. Go to R2 > Create Bucket (e.g., "todo-app-uploads")
#   2. Go to R2 > Manage R2 API Tokens > Create API Token
#   3. Use the S3-compatible endpoint, Access Key ID, and Secret Access Key
#   4. Set R2_PUBLIC_URL if you've enabled public access on the bucket

R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_REGION=auto
R2_BUCKET=todo-app-uploads
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_PUBLIC_URL=https://pub-<hash>.r2.dev

# Upload Limits
# Max file size per thumbnail upload (default: 5MB)
MAX_THUMBNAIL_SIZE=5242880
# Max file size per attachment upload (default: 20MB)
MAX_ATTACHMENT_SIZE=20971520
# Default storage quota per user in bytes (default: 100MB)
DEFAULT_STORAGE_QUOTA=104857600

# ────────────────────────────────────────────────────────
# PRODUCTION DEPLOYMENT (Cloudflare Pages)
# ────────────────────────────────────────────────────────
#
# Set these environment variables in your Cloudflare Pages dashboard:
#   Settings > Environment > Production > Environment Variables
#
# Required variables:
#   TURSO_CONNECTION_URL     — Production Turso database URL
#   TURSO_AUTH_TOKEN         — Production Turso auth token
#   GOOGLE_CLIENT_ID         — Google OAuth client ID (prod callback URL)
#   GOOGLE_CLIENT_SECRET     — Google OAuth client secret
#   BETTER_AUTH_SECRET       — Generate with: openssl rand -base64 32
#   BETTER_AUTH_URL          — https://<your-project>.pages.dev
#   STORAGE_MODE             — Set to "r2"
#   R2_ENDPOINT              — Cloudflare R2 S3 endpoint
#   R2_ACCESS_KEY_ID         — R2 API token access key
#   R2_SECRET_ACCESS_KEY     — R2 API token secret
#   R2_BUCKET                — R2 bucket name (e.g., "todo-app-uploads")
#
# Optional variables:
#   R2_PUBLIC_URL            — Public URL for direct R2 access
#   MAX_THUMBNAIL_SIZE       — Default: 5242880 (5MB)
#   MAX_ATTACHMENT_SIZE      — Default: 20971520 (20MB)
#   DEFAULT_STORAGE_QUOTA    — Default: 104857600 (100MB)
#
# Also set compatibility flag "nodejs_compat" in:
#   Cloudflare Pages > Settings > Environment > Production > Compatibility flags
