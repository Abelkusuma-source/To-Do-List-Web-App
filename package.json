{
  "name": "to-do-list-web-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "npx wrangler pages dev dist",
    "check": "astro check",
    "typecheck": "tsc --noEmit",
    "migrate": "drizzle-kit migrate",
    "migrate:prod": "npx dotenv -e .env.production -- drizzle-kit migrate",
    "push": "drizzle-kit push",
    "push:prod": "npx dotenv -e .env.production -- drizzle-kit push",
    "generate": "drizzle-kit generate",
    "deploy": "npx wrangler deploy --config dist/server/wrangler.json",
    "deploy:prod": "npx wrangler deploy --config dist/server/wrangler.json"
  },
  "optionalDependencies": {
    "sharp": "^0.34.5"
  },
  "overrides": {
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "~6.0.2"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.5.4",
    "@aws-sdk/client-s3": "^3.1053.0",
    "@aws-sdk/s3-request-presigner": "^3.1053.0",
    "@better-auth/drizzle-adapter": "^1.6.11",
    "@libsql/client": "^0.17.3",
    "@tabler/icons": "^3.44.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/vite": "^4.3.0",
    "astro": "^6.3.7",
    "aws4fetch": "^1.0.20",
    "better-auth": "^1.6.11",
    "drizzle-orm": "^0.45.2",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0"
  }
}
