---
import Layout from "../layouts/Layout.astro";

const session = {
  user: Astro.locals.user,
  session: Astro.locals.session,
};

// If already authenticated, redirect to dashboard
if (session.user) {
  return Astro.redirect("/dashboard");
}
---

<Layout title="Masuk - Catatan Tugas" description="Masuk ke Catatan Tugas untuk mengelola tugas harian Anda">
  <div class="flex min-h-dvh w-full items-center justify-center px-4 py-12">
    <div class="bg-card text-card-foreground ring-border w-full max-w-sm rounded-xl ring-1 shadow-lg animate-slideIn">
      <!-- Header -->
      <div class="px-8 pt-8 pb-4 text-center">
        <div class="mx-auto mb-4 flex size-14 items-center justify-center rounded-xl bg-primary/10">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="size-7 text-primary">
            <path d="M9 11l3 3L22 4" />
            <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11" />
          </svg>
        </div>
        <h1 class="text-xl font-bold tracking-tight text-foreground">Catatan Tugas</h1>
        <p class="mt-1 text-sm text-muted-foreground">Masuk untuk mengelola tugas harian Anda</p>
      </div>

      <!-- Divider -->
      <div class="px-8">
        <div class="flex items-center gap-3 py-2">
          <div class="h-px flex-1 bg-border"></div>
          <span class="text-xs font-medium text-muted-foreground">AKSES CEPAT</span>
          <div class="h-px flex-1 bg-border"></div>
        </div>
      </div>

      <!-- Google Sign In Button -->
      <div class="px-8 pb-6">
        <button
          id="google-signin-btn"
          class="inline-flex w-full items-center justify-center gap-3 rounded-lg font-medium whitespace-nowrap transition-all outline-none focus-visible:ring-3 disabled:pointer-events-none disabled:opacity-50 border border-input bg-background hover:bg-muted hover:text-foreground focus-visible:ring-outline/50 text-foreground h-11 px-5 text-sm shadow-xs"
        >
          <svg viewBox="0 0 24 24" class="size-5 shrink-0">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z"/>
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
          </svg>
          <span>Lanjutkan dengan Google</span>
        </button>
      </div>

      <!-- Footer -->
      <div class="border-t border-border px-8 py-4">
        <p class="text-center text-xs text-muted-foreground">
          Dengan masuk, Anda menyetujui
          <a href="#" class="underline underline-offset-2 hover:text-foreground transition-colors">Ketentuan Layanan</a>
          dan
          <a href="#" class="underline underline-offset-2 hover:text-foreground transition-colors">Kebijakan Privasi</a>
        </p>
      </div>
    </div>
  </div>

  <script>
    import { authClient } from "../lib/auth-client";

    document.getElementById("google-signin-btn")?.addEventListener("click", async () => {
      const btn = document.getElementById("google-signin-btn");
      if (btn) {
        btn.disabled = true;
        btn.innerHTML = `
          <svg class="animate-spin size-5" viewBox="0 0 24 24" fill="none">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/>
          </svg>
          <span>Mengalihkan...</span>
        `;
      }

      await authClient.signIn.social({
        provider: "google",
        callbackURL: "/dashboard",
      });
    });
  </script>
</Layout>
