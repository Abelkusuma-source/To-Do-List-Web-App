---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import Hero from "../components/marketing/Hero.astro";
import Features from "../components/marketing/Features.astro";
import Testimonials from "../components/marketing/Testimonials.astro";
import Footer from "../components/marketing/Footer.astro";
---

<MarketingLayout
  title="Catatan Tugas — Kelola tugas harian dengan mudah"
  description="Aplikasi Catatan Tugas modern untuk mengelola tugas harian Anda dengan fitur thumbnail, lampiran, dan prioritas."
>
  <!-- Navigation -->
  <nav class="fixed top-0 left-0 right-0 z-50 border-b border-border bg-background/80 backdrop-blur-lg">
    <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3 sm:px-6">
      <a href="/" class="flex items-center gap-2.5">
        <div class="flex size-9 items-center justify-center rounded-lg bg-primary shadow-xs">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-5 text-primary-foreground">
            <path d="M9 11l3 3L22 4" />
            <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11" />
          </svg>
        </div>
        <span class="text-lg font-bold tracking-tight text-foreground">Catatan Tugas</span>
      </a>

      <div class="flex items-center gap-1 sm:gap-2">
        <a
          href="/blog"
          class="inline-flex items-center justify-center gap-1.5 rounded-md px-3 py-2 text-sm font-medium text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
        >
          Blog
        </a>
        <a
          href="/login"
          class="inline-flex items-center justify-center gap-1.5 rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground shadow-xs transition-all hover:bg-primary/90"
        >
          Mulai
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4">
            <path d="M5 12h14" /><path d="m12 5 7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>
  </nav>

  <!-- Hero Section -->
  <Hero />

  <!-- Features Section -->
  <Features />

  <!-- Testimonials Section -->
  <Testimonials />

  <!-- How It Works Section -->
  <section class="border-t border-border py-20 sm:py-28">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="mx-auto max-w-2xl text-center">
        <span class="inline-flex items-center gap-1.5 rounded-full bg-secondary/10 px-3.5 py-1 text-xs font-medium text-secondary">
          CARA KERJA
        </span>
        <h2 class="mt-4 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
          Mulai dalam 3 Langkah
        </h2>
        <p class="mt-3 text-balance text-base text-muted-foreground">
          Cukup login dengan Google dan Anda siap mengelola tugas.
        </p>
      </div>

      <div class="mt-12 grid gap-8 sm:grid-cols-3">
        <div class="text-center">
          <div class="mx-auto mb-4 flex size-14 items-center justify-center rounded-2xl bg-primary/10">
            <span class="text-2xl font-bold text-primary">1</span>
          </div>
          <h3 class="text-lg font-semibold text-foreground">Login dengan Google</h3>
          <p class="mt-2 text-balance text-sm text-muted-foreground">
            Klik tombol "Mulai" dan login menggunakan akun Google Anda. Hanya butuh beberapa detik.
          </p>
        </div>

        <div class="text-center">
          <div class="mx-auto mb-4 flex size-14 items-center justify-center rounded-2xl bg-secondary/10">
            <span class="text-2xl font-bold text-secondary">2</span>
          </div>
          <h3 class="text-lg font-semibold text-foreground">Tambah Tugas</h3>
          <p class="mt-2 text-balance text-sm text-muted-foreground">
            Buat tugas baru dengan judul, deskripsi, tenggat waktu, prioritas, dan lampiran.
          </p>
        </div>

        <div class="text-center">
          <div class="mx-auto mb-4 flex size-14 items-center justify-center rounded-2xl bg-info/20">
            <span class="text-2xl font-bold text-info-foreground">3</span>
          </div>
          <h3 class="text-lg font-semibold text-foreground">Kelola & Selesaikan</h3>
          <p class="mt-2 text-balance text-sm text-muted-foreground">
            Atur status tugas, edit kapan saja, dan tandai selesai. Semua tersimpan otomatis di cloud.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA Section -->
  <section class="border-t border-border bg-muted/30 py-20 sm:py-28">
    <div class="mx-auto max-w-6xl px-4 text-center sm:px-6">
      <div class="mx-auto max-w-2xl">
        <h2 class="text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
          Siap Mencobanya?
        </h2>
        <p class="mt-3 text-balance text-base text-muted-foreground">
          Gratis selamanya. Tidak perlu kartu kredit. Cukup login dengan Google.
        </p>
        <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
          <a
            href="/login"
            class="inline-flex items-center justify-center gap-2 rounded-xl bg-primary px-8 py-3.5 text-base font-semibold text-primary-foreground shadow-lg shadow-primary/25 transition-all hover:bg-primary/90 hover:shadow-xl hover:shadow-primary/30"
          >
            Mulai Sekarang — Gratis
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-5">
              <path d="M5 12h14" /><path d="m12 5 7 7-7 7" />
            </svg>
          </a>
          <a
            href="/blog"
            class="inline-flex items-center justify-center gap-2 rounded-xl border border-input bg-background px-8 py-3.5 text-base font-semibold text-foreground shadow-xs transition-all hover:bg-muted"
          >
            Baca Blog
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <Footer />
</MarketingLayout>
