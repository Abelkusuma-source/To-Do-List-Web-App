---
import Layout from '../layouts/Layout.astro';
import { Button } from '@/components/starwind/button';
import { Card } from '@/components/starwind/card';
---

<Layout title="Catatan Tugas" description="Aplikasi Catatan Tugas - Kelola tugas harian Anda">
  <div id="app" class="w-full max-w-[640px] mx-auto px-4 py-8 min-h-dvh">
    <Card class="p-6 md:p-8 shadow-lg">
      <header class="text-center mb-6">
        <h1 class="text-2xl md:text-3xl font-bold tracking-tight text-foreground mb-1">
          Catatan Tugas
        </h1>
        <p class="text-sm text-muted-foreground">
          Kelola tugas harian Anda
        </p>
      </header>

      <main>
        <form id="todo-form" class="mb-5">
          <div class="flex items-center gap-2">
            <div class="relative flex-1">
              <svg
                class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 size-[18px] text-muted-foreground"
                viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round"
              >
                <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
              </svg>
              <input
                id="todo-input"
                type="text"
                placeholder="Tambahkan tugas baru..."
                autofocus
                autocomplete="off"
                class="border-input dark:bg-input/30 text-foreground w-full rounded-md border bg-transparent shadow-xs focus-visible:border-outline focus-visible:ring-outline/50 transition-[color,box-shadow] focus-visible:ring-3 placeholder:text-muted-foreground h-11 px-3 text-base pl-10 peer"
              />
            </div>
            <Button type="submit" variant="primary" size="icon" aria-label="Tambah tugas">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
            </Button>
          </div>
        </form>

        <div id="filter-bar" class="flex gap-1.5 mb-4 p-1 bg-muted rounded-md"></div>

        <ul id="todo-list" class="list-none p-0 m-0 flex flex-col gap-1 mb-4"></ul>

        <footer id="todo-footer" class="flex items-center justify-between pt-3.5 border-t border-border"></footer>
      </main>
    </Card>
  </div>

  <script src="/src/scripts/app.ts" type="module"></script>
</Layout>
