---
import { Card, CardHeader, CardTitle, CardDescription } from "../starwind/card";

interface Feature {
  icon: string;
  title: string;
  description: string;
  color: string;
  iconClass: string;
  svgHtml: string;
}

const features: Feature[] = [
  {
    icon: "checklist",
    title: "CRUD Tugas",
    description:
      "Tambah, edit, dan hapus tugas dengan mudah. Antarmuka yang intuitif dan responsif.",
    color: "bg-primary/10",
    iconClass: "text-primary",
    svgHtml:
      '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="size-5"><path d="M9 11l3 3L22 4" /><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11" /></svg>',
  },
  {
    icon: "lock",
    title: "Google Auth",
    description:
      "Masuk dengan akun Google Anda. Aman, cepat, dan tanpa repot mengingat password.",
    color: "bg-secondary/10",
    iconClass: "text-secondary",
    svgHtml:
      '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="size-5"><rect x="3" y="11" width="18" height="11" rx="2" ry="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>',
  },
  {
    icon: "image",
    title: "Thumbnail & Gambar",
    description:
      "Upload thumbnail untuk setiap tugas. Dukungan format PNG, JPG, dan WebP.",
    color: "bg-info/20",
    iconClass: "text-info-foreground",
    svgHtml:
      '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="size-5"><rect x="3" y="3" width="18" height="18" rx="2" ry="2" /><circle cx="8.5" cy="8.5" r="1.5" /><polyline points="21 15 16 10 5 21" /></svg>',
  },
  {
    icon: "file",
    title: "Lampiran File",
    description:
      "Lampirkan file PDF, DOCX, ZIP, dan lainnya. Maksimal 20MB per file. Drag & drop.",
    color: "bg-success/20",
    iconClass: "text-success-foreground",
    svgHtml:
      '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="size-5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /><line x1="16" y1="13" x2="8" y2="13" /><line x1="16" y1="17" x2="8" y2="17" /></svg>',
  },
  {
    icon: "clock",
    title: "Deadline & Prioritas",
    description:
      "Tentukan tenggat waktu dan prioritas (Rendah/Sedang/Tinggi) untuk setiap tugas.",
    color: "bg-warning/20",
    iconClass: "text-warning-foreground",
    svgHtml:
      '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="size-5"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>',
  },
  {
    icon: "star",
    title: "Cloud Storage",
    description:
      "Semua file tersimpan aman di cloud. 100MB penyimpanan gratis per pengguna.",
    color: "bg-primary/10",
    iconClass: "text-primary",
    svgHtml:
      '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="size-5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" /></svg>',
  },
];
---

<section class="border-t border-border py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="mx-auto max-w-2xl text-center">
      <span class="inline-flex items-center gap-1.5 rounded-full bg-primary/10 px-3.5 py-1 text-xs font-medium text-primary">
        FITUR
      </span>
      <h2 class="mt-4 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
        Segala yang Anda Butuhkan
      </h2>
      <p class="mt-3 text-balance text-base text-muted-foreground">
        Fitur lengkap untuk membantu Anda mengelola tugas sehari-hari dengan lebih produktif.
      </p>
    </div>

    <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {features.map((feature) => (
        <Card size="sm">
          <CardHeader>
            <div class={`mb-2 flex size-10 items-center justify-center rounded-lg ${feature.color}`}>
              <div class={feature.iconClass} set:html={feature.svgHtml} />
            </div>
            <CardTitle>{feature.title}</CardTitle>
            <CardDescription>{feature.description}</CardDescription>
          </CardHeader>
        </Card>
      ))}
    </div>
  </div>
</section>
