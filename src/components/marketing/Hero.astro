---
export interface Props {
  class?: string;
}
---

<section class="relative min-h-dvh overflow-hidden pt-24">
  <!-- Background Gradient -->
  <div class="pointer-events-none absolute inset-0 -z-10">
    <div class="absolute top-[-20%] left-[-10%] size-[500px] rounded-full bg-primary/5 blur-3xl"></div>
    <div class="absolute bottom-[-10%] right-[-5%] size-[400px] rounded-full bg-secondary/5 blur-3xl"></div>
  </div>

  <div class="mx-auto flex min-h-[calc(100dvh-6rem)] max-w-6xl flex-col items-center justify-center px-4 py-20 text-center sm:px-6">
    <!-- Badge -->
    <div class="mb-6 inline-flex items-center gap-1.5 rounded-full border border-border bg-muted/50 px-3.5 py-1 text-xs font-medium text-muted-foreground">
      <span class="flex size-2 rounded-full bg-success"></span>
      V6.0 — Online & Siap Digunakan
    </div>

    <!-- Headline -->
    <h1 class="max-w-3xl text-4xl font-bold tracking-tight text-foreground sm:text-5xl md:text-6xl lg:text-7xl">
      Kelola Tugas Harian
      <span class="bg-linear-to-r from-primary to-secondary bg-clip-text text-transparent">Tanpa Ribet</span>
    </h1>

    <!-- Subheadline -->
    <p class="mt-6 max-w-xl text-balance text-base text-muted-foreground sm:text-lg">
      Aplikasi catatan tugas modern dengan autentikasi Google, upload thumbnail & lampiran,
      prioritas tugas, dan penyimpanan cloud — semuanya gratis.
    </p>

    <!-- CTA Buttons -->
    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <a
        href="/login"
        class="inline-flex items-center justify-center gap-2 rounded-xl bg-primary px-6 py-3 text-base font-semibold text-primary-foreground shadow-lg shadow-primary/25 transition-all hover:bg-primary/90 hover:shadow-xl hover:shadow-primary/30"
      >
        Mulai Sekarang — Gratis
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-5">
          <path d="M5 12h14" /><path d="m12 5 7 7-7 7" />
        </svg>
      </a>
      <a
        href="/blog"
        class="inline-flex items-center justify-center gap-2 rounded-xl border border-input bg-background px-6 py-3 text-base font-semibold text-foreground shadow-xs transition-all hover:bg-muted"
      >
        Baca Blog
      </a>
    </div>

    <!-- Stats / Social Proof -->
    <div class="mt-12 flex flex-wrap items-center justify-center gap-8 sm:gap-12">
      <div class="text-center">
        <p class="text-2xl font-bold text-foreground">100%</p>
        <p class="text-xs text-muted-foreground">Gratis</p>
      </div>
      <div class="hidden h-8 w-px bg-border sm:block"></div>
      <div class="text-center">
        <p class="text-2xl font-bold text-foreground">Google</p>
        <p class="text-xs text-muted-foreground">Autentikasi</p>
      </div>
      <div class="hidden h-8 w-px bg-border sm:block"></div>
      <div class="text-center">
        <p class="text-2xl font-bold text-foreground">Cloud</p>
        <p class="text-xs text-muted-foreground">Cloudflare</p>
      </div>
      <div class="hidden h-8 w-px bg-border sm:block"></div>
      <div class="text-center">
        <p class="text-2xl font-bold text-foreground">Open</p>
        <p class="text-xs text-muted-foreground">Source</p>
      </div>
    </div>
  </div>
</section>
